# Stripe (existing)
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# Google Ads / Google tag (Consent Mode v2)
# Public conversion ID; code falls back to AW-18561285258 if unset
NEXT_PUBLIC_GADS_ID=AW-18561285258
# Optional: classic conversion label — only if Ads provides one (send_to).
# Event-based "Zakup" uses gtag event "purchase" and needs no label.
# NEXT_PUBLIC_GADS_PURCHASE_LABEL=

# Google Places API (New) — server-only reviews on homepage
# Place Details field mask rating,userRatingCount,reviews → SKU Place Details Enterprise + Atmosphere
# Do NOT prefix with NEXT_PUBLIC_ (must stay server-side)
# GOOGLE_PLACES_API_KEY=
# Place ID for Jankesowa Pasieka (from Google Maps / Place ID Finder):
# GOOGLE_PLACE_ID=ChIJs-KUIKYhA0cRnjkycy8dZfo
